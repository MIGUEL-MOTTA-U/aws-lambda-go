DATABASE_CONNECTION=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Cloudflare R2 — credentials from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=mi-app-assets
R2_ACCESS_KEY_ID=<r2-api-token-key-id>
R2_SECRET_ACCESS_KEY=<r2-api-token-secret>
R2_PUBLIC_URL=https://assets.tudominio.com


# Stage 1 only (pre-Cognito): allow uploads without a JWT authorizer.
# DEPRECATED: with the Cognito JWT guard active, owner_id comes from the
# sub claim and this flag is no longer needed. Set to false or remove.
ALLOW_UNAUTHENTICATED_UPLOADS=false

# Local dev server (used when running outside AWS Lambda via `go run .`)
PORT=8080
ACCESS_CONTROL_ALLOW_ORIGIN=http://localhost:5173

# ── Cognito JWT guard (Stage 2) ──────────────────────────────────────────────
# Con ambas variables definidas, TODA mutación (POST/PUT/DELETE en /listings,
# /users y /uploads) exige un Bearer JWT válido del User Pool (firma RS256
# contra el JWKS, expiración, issuer y audiencia). Sin definirlas el guard
# queda deshabilitado (solo para desarrollo). El backend NO hace OAuth (no
# necesita client secret ni redirect): solo VERIFICA tokens.
# Issuer = https://cognito-idp.<región>.amazonaws.com/<user-pool-id>
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_jyq6Yp72h
# Audience = client id del app client PÚBLICO que usa el front.
COGNITO_AUDIENCE=20ju54ui1a5u7lvsluu29ia0u1